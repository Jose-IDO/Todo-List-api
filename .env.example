# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection string
# Replace <YOUR_PASSWORD> with your actual PostgreSQL password
# Format: postgresql://username:password@host:port/database_name?schema=public
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/todo_list_api?schema=public"

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# Port on which the Express server will run (default: 3000)
PORT=3000

# ============================================================================
# AUTHENTICATION CONFIGURATION
# ============================================================================
# Secret key for signing JWT tokens
# Generate a secure random string using:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32-64 characters long for production
JWT_SECRET="your-long-random-jwt-secret-key-change-this-in-production"

# ============================================================================
# AI INTEGRATION (OPTIONAL)
# ============================================================================
# HuggingFace API token for AI-powered todo categorization
# Get your token from: https://huggingface.co/settings/tokens
# Only required if you want to use the AI categorization endpoint
# Leave blank if not using AI features
HF_API_KEY="hf_your_huggingface_api_key_here"

# ============================================================================
# NOTES
# ============================================================================
